# Own database, never the clients dashboard database.
DATABASE_URL=postgresql://localhost:5432/pizzabot
# Enable only after credentials, channels and independent worker are ready.
PIZZA_ENABLED=false
# Separate launch gate: due times before this explicit ISO timestamp never post.
# Leave disabled/blank until reviewed. Invalid/missing start safely stops scheduling.
PIZZA_CELEBRATIONS_ENABLED=false
PIZZA_CELEBRATIONS_START_AT=
PIZZA_BOT_TOKEN=
PIZZA_SIGNING_SECRET=
PIZZA_TEAM_ID=T01G975PL7M
PIZZA_APP_ID=A0C8JMFUETA
PIZZA_RECOGNITION_CHANNEL_ID=
PIZZA_ADMIN_CHANNEL_ID=
PIZZA_ADMIN_USER_IDS=U01G913DU2E,U0BFSH29PL7
PIZZA_PARTICIPANT_USER_IDS=
PIZZA_WORKER_SECRET=
# Worker service only: same secret as the web service, a separate random value
# of at least 32 characters. Never reuse the signing secret.
PIZZA_WORKER_ORIGIN=https://pizzabot-production-a20f.up.railway.app
# Optional test command only; must be disposable and loopback hosted.
PIZZA_TEST_DATABASE_URL=
